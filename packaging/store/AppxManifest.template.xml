<?xml version='1.0' encoding='utf-8'?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         IgnorableNamespaces="uap uap10 desktop rescap">
  <Identity Name="Desk.Preparacao.Store"
            Publisher="CN=Desk-Preparacao-Identidade-Pendente"
            Version="0.15.0.0"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Desk</DisplayName>
    <PublisherDisplayName>Desk - identidade pendente</PublisherDisplayName>
    <Description>Suporte remoto com aprovação local e dispositivos autorizados.</Description>
    <Logo>Assets\Logo50.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="pt-BR" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
  <Applications>
    <Application Id="Desk"
                 Executable="App\Desk.exe"
                 uap10:RuntimeBehavior="packagedClassicApp"
                 uap10:TrustLevel="mediumIL">
      <uap:VisualElements DisplayName="Desk"
                          Description="Suporte remoto consentido"
                          Square150x150Logo="Assets\Logo150.png"
                          Square44x44Logo="Assets\Logo44.png"
                          BackgroundColor="transparent" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask"
                           Executable="App\Desk.exe"
                           EntryPoint="Windows.FullTrustApplication"
                           uap10:Parameters="--background">
          <desktop:StartupTask TaskId="DeskStartup" Enabled="false" DisplayName="Desk" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
